Task 3: Creating Ansible Configuration and Inventory
Subtask 3.1: Create Project Directory Structure
Create a structured directory for your Ansible project.

# Create project directory
mkdir -p ~/ansible-k8s-lab
cd ~/ansible-k8s-lab

# Create subdirectories
mkdir -p playbooks roles inventory group_vars host_vars

# Create files
touch ansible.cfg inventory/hosts
Subtask 3.2: Configure Ansible
Create an Ansible configuration file.

cat > ansible.cfg << 'EOF'
[defaults]
inventory = inventory/hosts
host_key_checking = False
stdout_callback = yaml
gathering = explicit
deprecation_warnings = False

[inventory]
enable_plugins = host_list, script, auto, yaml, ini, toml
EOF
Subtask 3.3: Create Inventory File
Create an inventory file for localhost operations.

cat > inventory/hosts << 'EOF'
[local]
localhost ansible_connection=local ansible_python_interpreter=/usr/bin/python3

[k8s_cluster]
localhost ansible_connection=local ansible_python_interpreter=/usr/bin/python3
EOF
Task 4: Creating Kubernetes Resources with Ansible
Subtask 4.1: Create Namespace Management Playbook
Create a playbook to manage Kubernetes namespaces.

cat > playbooks/manage-namespace.yml << 'EOF'
---
- name: Manage Kubernetes Namespaces
  hosts: local
  gather_facts: no
  vars:
    namespace_name: "ansible-demo"
  
  tasks:
    - name: Create namespace
      kubernetes.core.k8s:
        name: "{{ namespace_name }}"
        api_version: v1
        kind: Namespace
        state: present
      register: namespace_result
    
    - name: Display namespace creation result
      debug:
        msg: "Namespace {{ namespace_name }} created successfully"
      when: namespace_result.changed
    
    - name: Verify namespace exists
      kubernetes.core.k8s_info:
        api_version: v1
        kind: Namespace
        name: "{{ namespace_name }}"
      register: namespace_info
    
    - name: Display namespace information
      debug:
        var: namespace_info.resources[0].metadata.name
EOF
Subtask 4.2: Run Namespace Management Playbook
Execute the namespace management playbook.

# Run the playbook
ansible-playbook playbooks/manage-namespace.yml

# Verify namespace creation using kubectl
kubectl get namespaces
Subtask 4.3: Create Deployment Management Playbook
Create a comprehensive playbook to manage Kubernetes deployments.

cat > playbooks/manage-deployment.yml << 'EOF'
---
- name: Manage Kubernetes Deployments
  hosts: local
  gather_facts: no
  vars:
    namespace_name: "ansible-demo"
    app_name: "nginx-app"
    app_image: "nginx:1.21"
    replica_count: 3
    app_port: 80
  
  tasks:
    - name: Create deployment
      kubernetes.core.k8s:
        state: present
        definition:
          apiVersion: apps/v1
          kind: Deployment
          metadata:
            name: "{{ app_name }}"
            namespace: "{{ namespace_name }}"
            labels:
              app: "{{ app_name }}"
          spec:
            replicas: "{{ replica_count }}"
            selector:
              matchLabels:
                app: "{{ app_name }}"
            template:
              metadata:
                labels:
                  app: "{{ app_name }}"
              spec:
                containers:
                - name: "{{ app_name }}"
                  image: "{{ app_image }}"
                  ports:
                  - containerPort: "{{ app_port }}"
                  resources:
                    requests:
                      memory: "64Mi"
                      cpu: "50m"
                    limits:
                      memory: "128Mi"
                      cpu: "100m"
      register: deployment_result
    
    - name: Display deployment creation result
      debug:
        msg: "Deployment {{ app_name }} created/updated successfully"
    
    - name: Wait for deployment to be ready
      kubernetes.core.k8s_info:
        api_version: apps/v1
        kind: Deployment
        name: "{{ app_name }}"
        namespace: "{{ namespace_name }}"
        wait: true
        wait_condition:
          type: Available
          status: "True"
        wait_timeout: 300
      register: deployment_status
    
    - name: Display deployment status
      debug:
        msg: "Deployment is ready with {{ deployment_status.resources[0].status.readyReplicas }} ready replicas"
EOF
Subtask 4.4: Run Deployment Management Playbook
Execute the deployment management playbook.

# Run the deployment playbook
ansible-playbook playbooks/manage-deployment.yml

# Verify deployment using kubectl
kubectl get deployments -n ansible-demo
kubectl get pods -n ansible-demo
Task 5: Managing Services with Ansible
Subtask 5.1: Create Service Management Playbook
Create a playbook to manage Kubernetes services.

cat > playbooks/manage-service.yml << 'EOF'
---
- name: Manage Kubernetes Services
  hosts: local
  gather_facts: no
  vars:
    namespace_name: "ansible-demo"
    app_name: "nginx-app"
    service_name: "nginx-service"
    service_port: 80
    target_port: 80
    service_type: "ClusterIP"
  
  tasks:
    - name: Create service
      kubernetes.core.k8s:
        state: present
        definition:
          apiVersion: v1
          kind: Service
          metadata:
            name: "{{ service_name }}"
            namespace: "{{ namespace_name }}"
            labels:
              app: "{{ app_name }}"
          spec:
            type: "{{ service_type }}"
            ports:
            - port: "{{ service_port }}"
              targetPort: "{{ target_port }}"
              protocol: TCP
            selector:
              app: "{{ app_name }}"
      register: service_result
    
    - name: Display service creation result
      debug:
        msg: "Service {{ service_name }} created/updated successfully"
    
    - name: Get service information
      kubernetes.core.k8s_info:
        api_version: v1
        kind: Service
        name: "{{ service_name }}"
        namespace: "{{ namespace_name }}"
      register: service_info
    
    - name: Display service details
      debug:
        msg: 
          - "Service Name: {{ service_info.resources[0].metadata.name }}"
          - "Service Type: {{ service_info.resources[0].spec.type }}"
          - "Cluster IP: {{ service_info.resources[0].spec.clusterIP }}"
          - "Port: {{ service_info.resources[0].spec.ports[0].port }}"
EOF
