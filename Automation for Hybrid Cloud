Task 2: Deploy a Web Service Across Multiple Platforms
Subtask 2.1: Create Web Service Application
Create a simple web service that will be deployed across both environments.

# Create application directory
mkdir -p ~/hybrid-cloud-automation/webservice
cd ~/hybrid-cloud-automation/webservice

# Create a simple Flask web application
cat > app.py << 'EOF'
from flask import Flask, jsonify, request
import os
import socket
import time
from datetime import datetime

app = Flask(__name__)

@app.route('/')
def home():
    return jsonify({
        'message': 'Hybrid Cloud Web Service',
        'environment': os.environ.get('ENVIRONMENT', 'unknown'),
        'hostname': socket.gethostname(),
        'timestamp': datetime.now().isoformat(),
        'version': '1.0.0'
    })

@app.route('/health')
def health():
    return jsonify({
        'status': 'healthy',
        'environment': os.environ.get('ENVIRONMENT', 'unknown'),
        'uptime': time.time(),
        'checks': {
            'database': 'connected',
            'cache': 'available'
        }
    })

@app.route('/info')
def info():
    return jsonify({
        'service': 'hybrid-web-service',
        'environment': os.environ.get('ENVIRONMENT', 'unknown'),
        'datacenter': os.environ.get('DATACENTER', 'unknown'),
        'instance_id': socket.gethostname(),
        'port': os.environ.get('PORT', '5000')
    })

if __name__ == '__main__':
    port = int(os.environ.get('PORT', 5000))
    app.run(host='0.0.0.0', port=port, debug=True)
EOF

# Create requirements file
cat > requirements.txt << 'EOF'
Flask==2.3.3
gunicorn==21.2.0
requests==2.31.0
EOF

# Create Dockerfile
cat > Dockerfile << 'EOF'
FROM python:3.9-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "app:app"]
EOF

# Build the Docker image
docker build -t hybrid-web-service:latest .
Subtask 2.2: Create Web Service Deployment Playbook
Create a comprehensive playbook to deploy the web service across both environments.

# Return to main project directory
cd ~/hybrid-cloud-automation

# Create web service deployment playbook
cat > playbooks/deploy-webservice.yml << 'EOF'
---
- name: Deploy Web Service to Hybrid Cloud
  hosts: all
  become: yes
  vars:
    web_service_image: hybrid-web-service:latest
    service_configs:
      onpremises:
        port: 5000
        replicas: 1
        environment:
          ENVIRONMENT: "on-premises"
          DATACENTER: "{{ datacenter }}"
          PORT: "5000"
          DATABASE_URL: "postgresql://admin:secure123@onprem-database:5432/onprem_db"
          CACHE_URL: "redis://onprem-cache:6379"
      cloud:
        port: 5001
        replicas: 2
        environment:
          ENVIRONMENT: "cloud"
          DATACENTER: "{{ datacenter }}"
          PORT: "5000"
          DATABASE_URL: "mysql://clouduser:cloudpass123@cloud-database:3306/cloud_db"
          CACHE_URL: "redis://localhost:6379"

  tasks:
    - name: Ensure web service image is available
      docker_image:
        name: "{{ web_service_image }}"
        source: local
        state: present

    - name: Deploy web service to on-premises
      docker_container:
        name: "webservice-onprem-{{ ansible_date_time.epoch }}"
        image: "{{ web_service_image }}"
        state: started
        restart_policy: always
        ports:
          - "{{ service_configs[environment_type].port }}:5000"
        env: "{{ service_configs[environment_type].environment }}"
        networks:
          - name: "{{ docker_network }}"
        labels:
          environment: "{{ environment_type }}"
          service: "web-service"
          version: "1.0.0"
      when: environment_type == 'onpremises'

    - name: Deploy web service to cloud
      docker_container:
        name: "webservice-cloud-{{ item }}-{{ ansible_date_time.epoch }}"
        image: "{{ web_service_image }}"
        state: started
        restart_policy: always
        ports:
          - "{{ service_configs[environment_type].port | int + item - 1 }}:5000"
        env: "{{ service_configs[environment_type].environment }}"
        networks:
          - name: "{{ docker_network }}"
        labels:
          environment: "{{ environment_type }}"
          service: "web-service"
          version: "1.0.0"
          replica: "{{ item }}"
      loop: "{{ range(1, service_configs[environment_type].replicas + 1) | list }}"
      when: environment_type == 'cloud'

    - name: Wait for web service to be ready
      wait_for:
        port: "{{ service_configs[environment_type].port }}"
        host: localhost
        delay: 5
        timeout: 60

    - name: Test web service endpoint
      uri:
        url: "http://localhost:{{ service_configs[environment_type].port }}"
        method: GET
        return_content: yes
      register: service_response

    - name: Display service response
      debug:
        msg: "Service response: {{ service_response.json }}"

    - name: Test health endpoint
      uri:
        url: "http://localhost:{{ service_configs[environment_type].port }}/health"
        method: GET
        return_content: yes
      register: health_response

    - name: Display health status
      debug:
        msg: "Health status: {{ health_response.json }}"
EOF
