Subtask 1.4: Create On-Premises Environment Playbook
Develop a playbook to set up the on-premises environment simulation.

# Create on-premises setup playbook
cat > playbooks/onprem-setup.yml << 'EOF'
---
- name: Setup On-Premises Environment
  hosts: onpremises
  become: yes
  vars:
    onprem_services:
      - name: onprem-database
        image: postgres:13
        ports:
          - "5432:5432"
        environment:
          POSTGRES_DB: onprem_db
          POSTGRES_USER: admin
          POSTGRES_PASSWORD: secure123
      - name: onprem-cache
        image: redis:6-alpine
        ports:
          - "6379:6379"

  tasks:
    - name: Create on-premises Docker network
      docker_network:
        name: "{{ docker_network }}"
        state: present

    - name: Create on-premises data directory
      file:
        path: /opt/onprem-data
        state: directory
        mode: '0755'

    - name: Deploy on-premises services
      docker_container:
        name: "{{ item.name }}"
        image: "{{ item.image }}"
        state: started
        restart_policy: always
        ports: "{{ item.ports | default([]) }}"
        env: "{{ item.environment | default({}) }}"
        networks:
          - name: "{{ docker_network }}"
        volumes:
          - "/opt/onprem-data:/var/lib/postgresql/data"
      loop: "{{ onprem_services }}"
      when: item.name == 'onprem-database'

    - name: Deploy Redis cache
      docker_container:
        name: "{{ item.name }}"
        image: "{{ item.image }}"
        state: started
        restart_policy: always
        ports: "{{ item.ports | default([]) }}"
        networks:
          - name: "{{ docker_network }}"
      loop: "{{ onprem_services }}"
      when: item.name == 'onprem-cache'

    - name: Wait for database to be ready
      wait_for:
        port: 5432
        host: localhost
        delay: 10
        timeout: 60

    - name: Display on-premises environment status
      debug:
        msg: "On-premises environment setup completed with {{ onprem_services | length }} services"
EOF
Subtask 1.5: Create Cloud Environment Playbook
Develop a playbook to simulate cloud environment setup.

# Create cloud setup playbook
cat > playbooks/cloud-setup.yml << 'EOF'
---
- name: Setup Cloud Environment
  hosts: cloud
  become: yes
  vars:
    cloud_services:
      - name: cloud-database
        image: mysql:8.0
        ports:
          - "3306:3306"
        environment:
          MYSQL_ROOT_PASSWORD: cloudpass123
          MYSQL_DATABASE: cloud_db
          MYSQL_USER: clouduser
          MYSQL_PASSWORD: cloudpass123
      - name: cloud-monitoring
        image: prom/prometheus:latest
        ports:
          - "9090:9090"
      - name: cloud-loadbalancer
        image: nginx:alpine
        ports:
          - "8080:80"

  tasks:
    - name: Create cloud Docker network
      docker_network:
        name: "{{ docker_network }}"
        state: present

    - name: Create cloud data directory
      file:
        path: /opt/cloud-data
        state: directory
        mode: '0755'

    - name: Create Prometheus configuration
      copy:
        content: |
          global:
            scrape_interval: 15s
          scrape_configs:
            - job_name: 'prometheus'
              static_configs:
                - targets: ['localhost:9090']
            - job_name: 'web-services'
              static_configs:
                - targets: ['localhost:5000', 'localhost:5001']
        dest: /opt/cloud-data/prometheus.yml
        mode: '0644'

    - name: Create Nginx configuration
      copy:
        content: |
          upstream webservices {
              server host.docker.internal:5000;
              server host.docker.internal:5001;
          }
          server {
              listen 80;
              location / {
                  proxy_pass http://webservices;
                  proxy_set_header Host $host;
                  proxy_set_header X-Real-IP $remote_addr;
              }
          }
        dest: /opt/cloud-data/nginx.conf
        mode: '0644'

    - name: Deploy cloud database
      docker_container:
        name: "{{ item.name }}"
        image: "{{ item.image }}"
        state: started
        restart_policy: always
        ports: "{{ item.ports | default([]) }}"
        env: "{{ item.environment | default({}) }}"
        networks:
          - name: "{{ docker_network }}"
        volumes:
          - "/opt/cloud-data/mysql:/var/lib/mysql"
      loop: "{{ cloud_services }}"
      when: item.name == 'cloud-database'

    - name: Deploy monitoring service
      docker_container:
        name: "{{ item.name }}"
        image: "{{ item.image }}"
        state: started
        restart_policy: always
        ports: "{{ item.ports | default([]) }}"
        networks:
          - name: "{{ docker_network }}"
        volumes:
          - "/opt/cloud-data/prometheus.yml:/etc/prometheus/prometheus.yml"
      loop: "{{ cloud_services }}"
      when: item.name == 'cloud-monitoring'

    - name: Deploy load balancer
      docker_container:
        name: "{{ item.name }}"
        image: "{{ item.image }}"
        state: started
        restart_policy: always
        ports: "{{ item.ports | default([]) }}"
        networks:
          - name: "{{ docker_network }}"
        volumes:
          - "/opt/cloud-data/nginx.conf:/etc/nginx/conf.d/default.conf"
      loop: "{{ cloud_services }}"
      when: item.name == 'cloud-loadbalancer'

    - name: Wait for services to be ready
      wait_for:
        port: "{{ item }}"
        host: localhost
        delay: 5
        timeout: 60
      loop:
        - 3306
        - 9090
        - 8080

    - name: Display cloud environment status
      debug:
        msg: "Cloud environment setup completed with {{ cloud_services | length }} services"
EOF
